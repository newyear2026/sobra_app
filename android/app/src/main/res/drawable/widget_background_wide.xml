<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher clips every widget to the system corner radius
    (@android:dimen/system_app_widget_background_radius, 28dp). Our card is
    rounded at 16dp, so its corners poke outside that mask and get shaved off
    together with the stroke unless they keep clear of the widget bounds. The
    card therefore sits 4dp in on every side, and the pixel shadow keeps its
    3dp bottom-right offset from there.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="7dp"
        android:top="7dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#26202848" />
        </shape>
    </item>
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="7dp"
        android:bottom="7dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#FFFFFDF7" />
            <stroke android:width="2dp" android:color="#FF202848" />
        </shape>
    </item>
</layer-list>
