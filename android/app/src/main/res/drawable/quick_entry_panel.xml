<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Navy outer pixel line with a cream inset, matching Sobra's cards. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF202848" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFF8E8" />
            <stroke
                android:width="1dp"
                android:color="#FF0E7A72" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
