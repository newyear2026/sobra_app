<?xml version="1.0" encoding="utf-8"?>
<!--
    Same clipping rule as widget_background_wide: the launcher masks the widget
    at the system 28dp radius, so the card keeps 4dp clear of the widget bounds
    on every side. Its own radius is 16dp rather than 15dp because a rounder
    corner sits further inside that mask, which matters more here — this card
    carries the thicker 3dp stroke.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="8dp"
        android:top="8dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <solid android:color="#2B202848" />
        </shape>
    </item>
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="8dp"
        android:bottom="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#FFFFFDF7" />
            <stroke android:width="3dp" android:color="#FF202848" />
        </shape>
    </item>
</layer-list>
