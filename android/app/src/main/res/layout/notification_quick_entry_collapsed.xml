<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_entry_root"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:background="@drawable/quick_entry_option2_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="5dp"
    android:paddingTop="3dp"
    android:paddingRight="5dp"
    android:paddingBottom="3dp">

    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/quick_entry_icon_frame"
        android:padding="3dp">

        <ImageView
            android:id="@+id/quick_entry_app_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/quick_entry_app_icon_description"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginLeft="5dp"
        android:layout_weight="1"
        android:background="@drawable/quick_entry_panel"
        android:orientation="horizontal"
        android:paddingLeft="2dp"
        android:paddingRight="2dp">

        <TextView
            android:id="@+id/quick_entry_income"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/quick_entry_action_background"
            android:contentDescription="@string/quick_entry_income"
            android:fontFamily="@font/pixelify_sans"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="＋ @string/quick_entry_income"
            android:textColor="#FF202848"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:background="#553E4662"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/quick_entry_expense"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/quick_entry_action_background"
            android:contentDescription="@string/quick_entry_expense"
            android:fontFamily="@font/pixelify_sans"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="＋ @string/quick_entry_expense"
            android:textColor="#FF202848"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
