<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_entry_root"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:background="@drawable/quick_entry_panel"
    android:orientation="vertical"
    android:paddingLeft="10dp"
    android:paddingTop="8dp"
    android:paddingRight="10dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/quick_entry_icon_frame"
            android:padding="3dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/quick_entry_cat_description"
                android:scaleType="fitCenter"
                android:src="@drawable/cat_saving_original_done" />
        </FrameLayout>

        <TextView
            android:id="@+id/quick_entry_question"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/quick_entry_question"
            android:textColor="#FF202848"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="3dp"
        android:background="#553E4662"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/quick_entry_income"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/quick_entry_action_background"
            android:contentDescription="@string/quick_entry_income"
            android:fontFamily="@font/pixelify_sans"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="＋ @string/quick_entry_income"
            android:textColor="#FF202848"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:background="#553E4662"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/quick_entry_expense"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/quick_entry_action_background"
            android:contentDescription="@string/quick_entry_expense"
            android:fontFamily="@font/pixelify_sans"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="＋ @string/quick_entry_expense"
            android:textColor="#FF202848"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
