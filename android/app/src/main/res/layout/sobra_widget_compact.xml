<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:contentDescription="@string/widget_compact_description"
    android:paddingLeft="15dp"
    android:paddingTop="15dp"
    android:paddingRight="19dp"
    android:paddingBottom="19dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pixelify_sans"
            android:includeFontPadding="false"
            android:text="@string/widget_today_remaining"
            android:textColor="#FF202848"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/today_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pixelify_sans"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="$461"
                android:textColor="#FF0E7A72"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginBottom="5dp"
                android:fontFamily="@font/pixelify_sans"
                android:includeFontPadding="false"
                android:text="MXN"
                android:textColor="#FF4E5878"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/days_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/pixelify_sans"
            android:includeFontPadding="false"
            android:text="13 días"
            android:textColor="#FF202848"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="17dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/widget_progress_frame"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView android:id="@+id/progress_1" style="@style/SobraWidgetProgressSegment" />
            <TextView android:id="@+id/progress_2" style="@style/SobraWidgetProgressSegment" />
            <TextView android:id="@+id/progress_3" style="@style/SobraWidgetProgressSegment" />
            <TextView android:id="@+id/progress_4" style="@style/SobraWidgetProgressSegment" />
            <TextView android:id="@+id/progress_5" style="@style/SobraWidgetProgressSegment" />
            <TextView android:id="@+id/progress_6" style="@style/SobraWidgetProgressSegment" />
            <TextView android:id="@+id/progress_7" style="@style/SobraWidgetProgressSegment" />
            <TextView android:id="@+id/progress_8" style="@style/SobraWidgetProgressSegment" />
            <TextView android:id="@+id/progress_9" style="@style/SobraWidgetProgressSegment" />
            <TextView android:id="@+id/progress_10" style="@style/SobraWidgetProgressSegmentLast" />
        </LinearLayout>
    </LinearLayout>

    <ViewFlipper
        android:id="@+id/cat_motion"
        android:layout_width="78dp"
        android:layout_height="54dp"
        android:layout_gravity="bottom|right"
        android:autoStart="true"
        android:flipInterval="900">
        <ImageView style="@style/SobraWidgetCatFrame" android:src="@drawable/cat_peek_open" />
        <ImageView style="@style/SobraWidgetCatFrame" android:src="@drawable/cat_peek_open" />
        <ImageView style="@style/SobraWidgetCatFrame" android:src="@drawable/cat_peek_open" />
        <ImageView style="@style/SobraWidgetCatFrame" android:src="@drawable/cat_peek_blink" />
    </ViewFlipper>

    <ImageView
        android:id="@+id/cat_static"
        style="@style/SobraWidgetCatFrame"
        android:layout_width="78dp"
        android:layout_height="54dp"
        android:layout_gravity="bottom|right"
        android:src="@drawable/cat_peek_open"
        android:visibility="gone" />
</FrameLayout>
