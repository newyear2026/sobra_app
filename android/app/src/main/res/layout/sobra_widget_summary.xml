<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_wide"
    android:contentDescription="@string/widget_summary_description"
    android:paddingLeft="15dp"
    android:paddingTop="10dp"
    android:paddingRight="17dp"
    android:paddingBottom="13dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="4dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/today_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pixelify_sans"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_today_remaining"
                    android:textColor="#FF202848"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/today_amount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/pixelify_sans"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="−$2,000"
                        android:textColor="#FF0E7A72"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="3dp"
                        android:id="@+id/currency_code"
                        android:layout_marginBottom="3dp"
                        android:fontFamily="@font/pixelify_sans"
                        android:includeFontPadding="false"
                        android:text="MXN"
                        android:textColor="#FF4E5878"
                        android:textSize="8sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="100dp"
                android:layout_height="match_parent">

                <ViewFlipper
                    android:id="@+id/cat_motion"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:autoStart="true"
                    android:flipInterval="600">

                    <ImageView android:id="@+id/character_frame_1" style="@style/SobraWidgetCatFrame" android:src="@drawable/cat_saving_original_high" />
                    <ImageView android:id="@+id/character_frame_2" style="@style/SobraWidgetCatFrame" android:src="@drawable/cat_saving_original_mid" />
                    <ImageView android:id="@+id/character_frame_3" style="@style/SobraWidgetCatFrame" android:src="@drawable/cat_saving_original_drop" />
                    <ImageView android:id="@+id/character_frame_4" style="@style/SobraWidgetCatFrame" android:src="@drawable/cat_saving_original_done" />
                    <ImageView android:id="@+id/character_frame_5" style="@style/SobraWidgetCatFrame" android:src="@drawable/cat_saving_original_done" />
                </ViewFlipper>

                <ImageView
                    android:id="@+id/cat_static"
                    style="@style/SobraWidgetCatFrame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:src="@drawable/cat_saving_original_done"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/pixelify_sans"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_cycle_progress"
                android:textColor="#FF202848"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/days_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:fontFamily="@font/pixelify_sans"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="8 días"
                android:textColor="#FF0E7A72"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="1dp"
            android:background="@drawable/widget_progress_frame"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView android:id="@+id/progress_1" style="@style/SobraWidgetProgressSegment" />
            <TextView android:id="@+id/progress_2" style="@style/SobraWidgetProgressSegment" />
            <TextView android:id="@+id/progress_3" style="@style/SobraWidgetProgressSegment" />
            <TextView android:id="@+id/progress_4" style="@style/SobraWidgetProgressSegment" />
            <TextView android:id="@+id/progress_5" style="@style/SobraWidgetProgressSegment" />
            <TextView android:id="@+id/progress_6" style="@style/SobraWidgetProgressSegment" />
            <TextView android:id="@+id/progress_7" style="@style/SobraWidgetProgressSegment" />
            <TextView android:id="@+id/progress_8" style="@style/SobraWidgetProgressSegment" />
            <TextView android:id="@+id/progress_9" style="@style/SobraWidgetProgressSegment" />
            <TextView android:id="@+id/progress_10" style="@style/SobraWidgetProgressSegmentLast" />
        </LinearLayout>


        <TextView
            android:id="@+id/register_button"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/widget_button"
            android:contentDescription="@string/widget_register_expense"
            android:fontFamily="@font/pixelify_sans"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="+  Registrar gasto"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
